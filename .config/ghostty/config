term = "xterm-256color"

shell-integration = zsh

font-family = MesloLGS Nerd Font Mono
font-size = 14

background-opacity = 1
background-blur = true

theme = tokyonight

mouse-hide-while-typing = true

auto-update = check

window-save-state = always

scrollback-limit = 1000000

keybind = ctrl+a>c=new_tab

